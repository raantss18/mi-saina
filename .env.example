# mi-saina — Configuration
# Copier ce fichier en .env et adapter les valeurs

OLLAMA_BASE_URL=http://localhost:11434

# Modèle principal (raisonnement, génération de code, analyse)
# Exemples: qwen3.5:9b, magistral:small, deepseek-r1:8b, gemma3:12b
REASONING_MODEL=qwen3.5:9b

# Modèle rapide (nommage sessions, tâches courtes)
# Peut être identique au modèle principal
FAST_MODEL=qwen3.5:9b

# Modèle DÉDIÉ aux embeddings (mémoire sémantique). Garde un petit modèle :
# beaucoup de modèles génératifs (gemma3…) ne savent pas faire d'embeddings.
# À installer une fois : ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

HOST=127.0.0.1
PORT=8000
MAX_SEARCH_RESULTS=5
SHELL_TIMEOUT=30

# Demander une confirmation (Exécuter/Refuser) avant chaque commande shell
CONFIRM_MODE=risky
# Nombre max d'étapes agentiques (modèle → commande → résultat → modèle) par requête
MAX_AGENT_STEPS=6

# ── Secours cloud 100 % gratuit (OpenRouter) ─────────────────────────────────
# "ollama" (défaut) = tout reste local. "openrouter" = modèles gratuits OpenRouter
# d'abord, repli automatique sur Ollama si quota épuisé / hors ligne.
# ⚠ En mode "openrouter", tes messages sortent de la machine.
LLM_BACKEND=ollama
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
